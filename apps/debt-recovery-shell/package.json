{
  "name": "debt-recovery-shell",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "localdev": "vite",
    "devlocal": "vite --mode development",
    "dev:105": "vite --mode dev105",
    "int:196": "vite --mode int196",
	"staging": "vite --mode staging",
    "build": "set NODE_OPTIONS=--max-old-space-size=6000 && vite build",
    "generate-config": "node scripts/generate-config.js",
    "runtime-config": "node scripts/generate-config.js",
    "build:dev105": "node --max-old-space-size=6000 ./node_modules/vite/bin/vite.js build --mode dev105",
    "build:int": "node --max-old-space-size=6000 ./node_modules/vite/bin/vite.js build --mode int",
    "build:int196": "node --max-old-space-size=6000 ./node_modules/vite/bin/vite.js build --mode int196",
    "build:staging": "node --max-old-space-size=6000 ./node_modules/vite/bin/vite.js build --mode staging",
    "build:development": "node --max-old-space-size=6000 ./node_modules/vite/bin/vite.js build --mode development",
    "build:release": "node --max-old-space-size=6000 ./node_modules/vite/bin/vite.js build --mode release"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/x-date-pickers": "9.10.1",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/query-persist-client-core": "^5.100.11",
    "@tanstack/query-sync-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "axios": "^1.7.9",
    "diagram-js": "^14.11.3",
    "dayjs": "^1.11.18",
    "htm": "^3.1.1",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.6.3",
    "react-toastify": "^11.0.5",
    "tiny-svg": "^3.1.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jest": "^30.1.3",
    "jest-junit": "^16.0.0",
    "vite": "^5.4.11",
    "vitest": "^3.2.4",
    "vitest-sonar-reporter": "^2.0.4"
  }
}
