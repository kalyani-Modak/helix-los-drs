    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "react-router-dom": "7.6.3",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@mui/icons-material": "7.3.11",
