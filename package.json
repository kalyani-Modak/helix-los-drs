{
  "name": "monoDebtRecovery",
  "private": true,
  "version": "0.0.1-SNAPSHOT",
  "workspaces": [
    "apps/*",
    "products/*",
    "shared"
  ],
  "scripts": {
    "devlocal": "pnpm --filter debt-recovery-shell run devlocal",
    "dev-105-server": "pnpm --filter debt-recovery-shell run dev:105",
    "int-196-server": "pnpm --filter debt-recovery-shell run int:196",
    "staging": "pnpm --filter debt-recovery-shell run staging",
    "int": "pnpm --filter debt-recovery-shell run int",
    "build": "pnpm --filter debt-recovery-shell run build",
    "build:dev105": "pnpm --filter debt-recovery-shell run build:dev105",
    "build:int": "pnpm --filter debt-recovery-shell run build:int",
    "build:int196": "pnpm --filter debt-recovery-shell run build:int196",
    "build:staging": "pnpm --filter debt-recovery-shell run build:staging",
    "build:development": "pnpm --filter debt-recovery-shell run build:development",
    "build:release": "pnpm --filter debt-recovery-shell run build:release",
    "changeset": "pnpm exec changeset",
    "release:check": "pnpm exec changeset status --since=origin/main",
    "release:version": "pnpm exec changeset version",
    "release:tag:packages": "pnpm exec changeset tag",
    "release:prepare": "pnpm run release:version && pnpm --filter debt-recovery-shell build",
    "release": "pnpm run release:prepare && pnpm run release:tag:packages && node release/tag-repo.js"
  },
  "dependencies": {
    "@bpmn-io/properties-panel": "^3.52.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@helix/component-library": "0.4.1",
    "@kie-tools/kie-editors-standalone": "^10.1.0",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/system": "7.3.11",
    "@mui/x-data-grid": "9.10.1",
    "@mui/x-date-pickers": "9.10.1",
    "@onlyoffice/document-editor-react": "^2.1.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@stomp/stompjs": "^7.0.0",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/query-persist-client-core": "^5.100.11",
    "@tanstack/query-sync-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "ag-grid-community": "^32.3.9",
    "ag-grid-react": "^32.3.9",
    "apexcharts": "^5.3.6",
    "axios": "^1.10.0",
    "bpmn-js": "^17.11.1",
    "bpmn-js-bpmnlint": "^0.24.0",
    "bpmn-js-properties-panel": "^5.65.0",
    "bpmnlint": "^11.13.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dmn-moddle": "^9.0.3",
    "framer-motion": "^12.36.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "jspreadsheet-ce": "^5.0.4",
    "jsrsasign": "^11.1.0",
    "jsuites": "^6.4.2",
    "jwt-decode": "^4.0.0",
    "livekit-client": "^2.15.6",
    "loglevel": "^1.9.2",
    "lottie-react": "^2.4.1",
    "prop-types": "^15.8.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-apexcharts": "^1.8.0",
    "react-dom": "19.2.8",
    "react-icons": "^5.6.0",
    "react-intl": "^7.1.11",
    "react-is": "^19.2.8",
    "react-redux": "^9.2.0",
    "react-router-dom": "7.6.3",
    "react-toastify": "^9.1.3",
    "recharts": "^3.8.0",
    "redux-persist": "^6.0.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
